/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: no-referrer

# Service worker dan halaman utama tidak boleh disimpan peramban.
# Tanpa ini, HP bisa memakai sw.js lama sampai berjam-jam sehingga versi
# baru tidak pernah terpasang walaupun unggahan ke Netlify sudah berhasil.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
